MONGODB_URI=mongodb://127.0.0.1:27017/toolnest
MONGODB_DB=toolnest
NEXTAUTH_SECRET=changeme
PORT=3002

# Must match the URL you actually access the app at (protocol + host + PORT above).
# Only needed for local dev — on Vercel, leave both unset and auth.ts's trustHost:true
# will derive the correct URL from each deployment's request host automatically.
AUTH_URL=http://localhost:3002
NEXTAUTH_URL=http://localhost:3002

# Used only when running `npm run seed:admin` — not read by the app itself.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Resend (https://resend.com) — used to email admins when a user applies for Pro.
# Leave RESEND_API_KEY unset to skip sending (a warning is logged instead).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
